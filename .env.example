# ECAT — LLM API Keys
# Copy this file to .env in your WORKSPACE directory and fill in the keys you need.
# .env is gitignored and never committed.
#
# NOTE: base_url and model are configured in ecat.config.yaml, not here.
#       .env only stores secrets (API keys).

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Used by: claude_code runtime, anthropic_sdk judge
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ─── Claude subscription (macOS) ─────────────────────────────────────────────
# Used by: claude_code runtime with api_key_env: "" on macOS, where the login
# lives in the Keychain. Get it with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=xxxxx

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Used by: opencode runtime with OpenAI models
OPENAI_API_KEY=sk-xxxxx

# ─── Google Gemini ───────────────────────────────────────────────────────────
# Used by: opencode runtime with Gemini models
GOOGLE_API_KEY=AIza-xxxxx

# ─── DeepSeek ────────────────────────────────────────────────────────────────
# Used by: opencode runtime with DeepSeek models
DEEPSEEK_API_KEY=sk-xxxxx

# ─── Custom OpenAI-compatible ────────────────────────────────────────────────
# Used by: any runtime with base_url in ecat.config.yaml pointing to your endpoint
# CUSTOM_API_KEY=xxxxx
